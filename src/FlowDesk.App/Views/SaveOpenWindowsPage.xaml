<Page
    x:Class="FlowDesk.App.Views.SaveOpenWindowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FlowDesk.App.Services"
    xmlns:vm="using:FlowDesk.App.ViewModels">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="16">
            <TextBlock Text="Save open windows" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Browser tabs cannot be read. Add links to reopen them in a new browser window."
                TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Windows on other virtual desktops are not listed."
                Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox Header="Workspace name" MaxLength="120" Text="{Binding Name, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <ProgressRing IsActive="{Binding IsLoading}" Width="24" Height="24" />
            </StackPanel>
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding Error}"
                      IsClosable="False" />
            <TextBlock Text="No windows are available. Open an app or folder, then refresh."
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"
                TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CandidateViewModel">
                        <Border Padding="12,6" MinHeight="60" Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Spacing="8">
                                 <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                     IsEnabled="{Binding CanSelect}"
                                     HorizontalContentAlignment="Stretch"
                                     AutomationProperties.Name="{Binding Name}"
                                    ToolTipService.ToolTip="{Binding Secondary}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="24" Height="24"
                                              VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image services:IconSource.Path="{Binding ExePath}"
                                                   Width="24" Height="24" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Secondary}"
                                                Visibility="{Binding HasNoProblem, Converter={StaticResource BoolVisibility}}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Secondary}"
                                                Visibility="{Binding HasProblem, Converter={StaticResource BoolVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                                <Expander Header="Browser links"
                                    Visibility="{Binding IsBrowser, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Tabs cannot be read. Add pages to reopen, one per line."
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                        <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                            MinHeight="72" PlaceholderText="https://example.com"
                                            Text="{Binding Links, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Content="Save workspace" Command="{Binding SaveCommand}"
                         Style="{StaticResource AccentButtonStyle}" AccessKey="S" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
