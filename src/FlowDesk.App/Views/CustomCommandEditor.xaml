<UserControl
    x:Class="FlowDesk.App.Views.CustomCommandEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" MinWidth="320">
            <TextBox x:Name="CommandNameBox" Header="Name"
                     AutomationProperties.Name="Command name" />
            <TextBox x:Name="KeywordsBox" Header="Keywords" PlaceholderText="e.g. yt"
                     AutomationProperties.Name="Keywords" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TargetBox" Header="Target"
                         AutomationProperties.Name="Target" />
                <Button x:Name="BrowseTargetButton" Grid.Column="1"
                        Content="Browse…" MinHeight="32" Padding="12,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Browse for target"
                        Click="BrowseTarget_Click" />
            </Grid>
            <StackPanel Spacing="2">
                <TextBox x:Name="ArgumentsBox" Header="Arguments"
                         AutomationProperties.Name="Arguments" />
                <TextBlock Text="{}{query} is replaced only when you run a command. URLs encode the query."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IconBox" Header="Icon path (optional)"
                         AutomationProperties.Name="Icon path" />
                <Button x:Name="BrowseIconButton" Grid.Column="1"
                        Content="Browse…" MinHeight="32" Padding="12,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Browse for icon"
                        Click="BrowseIcon_Click" />
            </Grid>
            <ComboBox x:Name="KindBox" Header="Target kind"
                      AutomationProperties.Name="Target kind">
                <ComboBoxItem Content="URL" />
                <ComboBoxItem Content="Folder" />
                <ComboBoxItem Content="File" />
                <ComboBoxItem Content="Program" />
                <ComboBoxItem Content="PowerShell script" />
            </ComboBox>
            <CheckBox x:Name="AdminBox" Content="Run as administrator (programs and scripts only)"
                      AutomationProperties.Name="Run as administrator" />
            <TextBlock x:Name="ValidationText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
