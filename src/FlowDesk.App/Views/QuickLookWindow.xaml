<Window x:Class="FlowDesk.App.Views.QuickLookWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Width="32" Height="32"><SymbolIcon x:Name="DefaultIcon" Symbol="Document"/><Image x:Name="FileIcon"/></Grid>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock x:Name="FileName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="Details" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Button Grid.Column="2" Content="Open" Click="Open_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Open in the default app (Enter)"/>
   <Button Grid.Column="3" Click="Close_Click" VerticalAlignment="Center" AutomationProperties.Name="Close preview" ToolTipService.ToolTip="Close preview (Esc)"><SymbolIcon Symbol="Cancel"/></Button>
  </Grid>
  <Grid Grid.Row="1">
   <ContentControl x:Name="Preview" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <ProgressRing x:Name="Loading" Width="32" Height="32" IsActive="False" Visibility="Collapsed"/>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="Status" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
 </Grid>
</Window>
