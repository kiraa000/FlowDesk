<Page
    x:Class="FlowDesk.App.Views.WorkspaceDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FlowDesk.App.Services"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:FlowDesk.App.ViewModels">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="16">
            <BreadcrumbBar ItemsSource="{Binding Breadcrumbs}" ItemClicked="Breadcrumbs_ItemClicked" />
            <TextBlock Text="Workspace details" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBox Header="Name" MaxLength="120" Text="{Binding Workspace.Name, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Another workspace has this name. You can keep it or choose a different name."
                       Visibility="{Binding Workspace.HasDuplicateName, Converter={StaticResource BoolVisibility}}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" />
            <TextBox Header="Description" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" Text="{Binding Workspace.Description, Mode=TwoWay,
                     UpdateSourceTrigger=PropertyChanged}" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Colour" ItemsSource="{Binding ColorOptions}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Workspace.Color, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Value, Converter={StaticResource TagColor}}" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" Header="Icon" ItemsSource="{Binding GlyphOptions}"
                           DisplayMemberPath="Label" SelectedValuePath="Glyph"
                           SelectedValue="{Binding Workspace.Glyph, Mode=TwoWay}" />
            </Grid>
            <StackPanel Spacing="4">
                <ToggleSwitch Header="Keep this workspace up to date"
                              IsOn="{Binding Workspace.AutosaveEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Keep this workspace up to date" />
                <TextBlock Text="Saves window positions after they settle. New windows are offered before they are added."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <ToggleSwitch Header="Always add new windows"
                              IsOn="{Binding Workspace.AlwaysAddNewWindows, Mode=TwoWay}"
                              AutomationProperties.Name="Always add new windows to this workspace" />
                <TextBlock Text="Adds a newly opened window to this workspace without asking."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="When this workspace opens"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="FlowDesk can also set your PC's mode. Nothing changes back when you leave."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <settings:SettingsCard Header="Preset" IsTabStop="False"
                        Description="Fills the settings below. You can change them after.">
                        <ComboBox MinWidth="200"
                                  PlaceholderText="Custom"
                                  SelectedIndex="{Binding Workspace.ContextEditor.PresetIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Preset">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="Study" />
                            <ComboBoxItem Content="Coding" />
                            <ComboBoxItem Content="Gaming" />
                        </ComboBox>
                    </settings:SettingsCard>
                    <settings:SettingsCard Header="Focus session" IsTabStop="False">
                        <settings:SettingsCard.Description>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Uses the apps on the Focus page."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Workspace.ContextEditor.Caution}"
                                           Visibility="{Binding Workspace.ContextEditor.HasCaution, Converter={StaticResource BoolVisibility}}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </settings:SettingsCard.Description>
                        <StackPanel Spacing="8" MinWidth="220">
                            <ComboBox HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding Workspace.ContextEditor.FocusIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Focus session">
                                <ComboBoxItem Content="Don't change" />
                                <ComboBoxItem Content="Start a focus session" />
                                <ComboBoxItem Content="End a focus session" />
                            </ComboBox>
                            <StackPanel Spacing="8"
                                        Visibility="{Binding Workspace.ContextEditor.FocusStartVisible, Converter={StaticResource BoolVisibility}}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duration (minutes)" VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox Grid.Column="1" MinWidth="120"
                                              ItemsSource="{Binding Workspace.ContextEditor.DurationChoices}"
                                              SelectedItem="{Binding Workspace.ContextEditor.FocusMinutes, Mode=TwoWay}"
                                              AutomationProperties.Name="Focus session duration in minutes" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Strictness" VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox Grid.Column="1" MinWidth="120"
                                              SelectedIndex="{Binding Workspace.ContextEditor.StrictnessIndex, Mode=TwoWay}"
                                              AutomationProperties.Name="Focus session strictness">
                                        <ComboBoxItem Content="Gentle" />
                                        <ComboBoxItem Content="Normal" />
                                        <ComboBoxItem Content="Strict" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </settings:SettingsCard>
                    <settings:SettingsCard Header="Do not disturb" IsTabStop="False">
                        <settings:SettingsCard.Description>
                            <TextBlock Text="Silences most notifications. Alarms and priority notifications can still arrive. Uses an experimental Windows interface."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </settings:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <ComboBox MinWidth="160"
                                      Visibility="{Binding Workspace.ContextEditor.DndAvailable, Converter={StaticResource BoolVisibility}}"
                                      SelectedIndex="{Binding Workspace.ContextEditor.DndIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Do not disturb">
                                <ComboBoxItem Content="Don't change" />
                                <ComboBoxItem Content="Turn on" />
                                <ComboBoxItem Content="Turn off" />
                            </ComboBox>
                            <StackPanel Spacing="2"
                                        Visibility="{Binding Workspace.ContextEditor.DndUnavailable, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Not available on this PC."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <HyperlinkButton Content="Open notification settings"
                                                 NavigateUri="ms-settings:notifications"
                                                 AutomationProperties.Name="Open notification settings" />
                            </StackPanel>
                        </StackPanel>
                    </settings:SettingsCard>
                    <settings:SettingsCard Header="Sound output" IsTabStop="False">
                        <settings:SettingsCard.Description>
                            <TextBlock Text="Switches the default playback device when this workspace opens. Uses an experimental Windows interface."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </settings:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <ComboBox MinWidth="200"
                                      Visibility="{Binding Workspace.ContextEditor.AudioAvailable, Converter={StaticResource BoolVisibility}}"
                                      ItemsSource="{Binding Workspace.ContextEditor.AudioChoices}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding Workspace.ContextEditor.SelectedAudio, Mode=TwoWay}"
                                      AutomationProperties.Name="Sound output" />
                            <StackPanel Spacing="2"
                                        Visibility="{Binding Workspace.ContextEditor.AudioUnavailable, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Not available on this PC."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <HyperlinkButton Content="Open sound settings"
                                                 NavigateUri="ms-settings:sound"
                                                 AutomationProperties.Name="Open sound settings" />
                                <Button Content="Don't change sound output"
                                        Command="{Binding Workspace.ContextEditor.ClearSoundOutputCommand}"
                                        IsEnabled="{Binding Workspace.ContextEditor.HasSoundOutput}"
                                        AutomationProperties.Name="Don't change sound output" />
                            </StackPanel>
                        </StackPanel>
                    </settings:SettingsCard>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <DropDownButton Content="Add" MinWidth="72">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem Text="App">
                                <MenuFlyoutItem Text="Running app" Command="{Binding AddRunningCommand}" />
                                <MenuFlyoutItem Text="Browse for .exe" Command="{Binding AddAppCommand}" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem Text="Website" Command="{Binding AddWebsiteCommand}" />
                            <MenuFlyoutItem Text="File" Command="{Binding AddFileCommand}" />
                            <MenuFlyoutItem Text="Folder" Command="{Binding AddFolderCommand}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Content="Save current positions"
                        Command="{Binding Workspace.SavePositionsCommand}" />
                <Button Content="Open" Command="{Binding Workspace.OpenCommand}"
                         Style="{StaticResource AccentButtonStyle}" AccessKey="O" />
                <Button Content="More">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Reset to saved layout" Command="{Binding Workspace.ResetCommand}" />
                            <MenuFlyoutItem Text="Delete workspace" Command="{Binding Workspace.DeleteCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <TextBlock Text="No items yet. Add an app, website, file or folder."
                Visibility="{Binding Workspace.IsEmpty, Converter={StaticResource BoolVisibility}}"
                Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding Workspace.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemViewModel">
                        <Border Padding="12" Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="32" Height="32">
                                    <FontIcon Glyph="{Binding Glyph}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image services:IconSource.Path="{Binding ExePath}"
                                           Width="24" Height="24" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Name}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}"
                                        ToolTipService.ToolTip="{Binding ExePath}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Position}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <ToggleSwitch OnContent="Reopen my last tabs" OffContent="Reopen my last tabs"
                                                  Visibility="{Binding IsBrowser, Converter={StaticResource BoolVisibility}}"
                                                  IsOn="{Binding ReopenLastTabs, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="Starts the browser with its profile so it restores its own last session."
                                                  AutomationProperties.Name="Reopen my last browser tabs" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Edit" Command="{Binding EditCommand}" />
                                    <Button Content="Remove"
                                            Command="{Binding RemoveCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Windows running as administrator may not be moved. Closed windows keep their saved positions."
                TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
