<Page
    x:Class="FlowDesk.App.Views.WorkspaceDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FlowDesk.App.Services"
    xmlns:vm="using:FlowDesk.App.ViewModels">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="16">
            <BreadcrumbBar ItemsSource="{Binding Breadcrumbs}" ItemClicked="Breadcrumbs_ItemClicked" />
            <TextBlock Text="Workspace details" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBox Header="Name" MaxLength="120" Text="{Binding Workspace.Name, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Description" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" Text="{Binding Workspace.Description, Mode=TwoWay,
                     UpdateSourceTrigger=PropertyChanged}" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Colour" ItemsSource="{Binding ColorOptions}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Workspace.Color, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Value, Converter={StaticResource TagColor}}" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" Header="Icon" ItemsSource="{Binding GlyphOptions}"
                           DisplayMemberPath="Label" SelectedValuePath="Glyph"
                           SelectedValue="{Binding Workspace.Glyph, Mode=TwoWay}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <DropDownButton Content="Add" MinWidth="72">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem Text="App">
                                <MenuFlyoutItem Text="Running app" Command="{Binding AddRunningCommand}" />
                                <MenuFlyoutItem Text="Browse for .exe" Command="{Binding AddAppCommand}" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem Text="Website" Command="{Binding AddWebsiteCommand}" />
                            <MenuFlyoutItem Text="File" Command="{Binding AddFileCommand}" />
                            <MenuFlyoutItem Text="Folder" Command="{Binding AddFolderCommand}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Content="Save current positions"
                        Command="{Binding Workspace.SavePositionsCommand}" />
                <Button Content="Open" Command="{Binding Workspace.OpenCommand}"
                         Style="{StaticResource AccentButtonStyle}" AccessKey="O" />
                <Button Content="More">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Reset to saved layout" Command="{Binding Workspace.ResetCommand}" />
                            <MenuFlyoutItem Text="Delete workspace" Command="{Binding Workspace.DeleteCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <TextBlock Text="No items yet. Add an app, website, file or folder."
                Visibility="{Binding Workspace.IsEmpty, Converter={StaticResource BoolVisibility}}"
                Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding Workspace.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemViewModel">
                        <Border Padding="12" Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="32" Height="32">
                                    <FontIcon Glyph="{Binding Glyph}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image services:IconSource.Path="{Binding ExePath}"
                                           Width="24" Height="24" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Name}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Position}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Remove"
                                        Command="{Binding RemoveCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Windows running as administrator may not be moved. Closed windows keep their saved positions."
                TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
