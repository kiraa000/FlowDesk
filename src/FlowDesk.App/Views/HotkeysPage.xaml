<Page
    x:Class="FlowDesk.App.Views.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Text="Hotkeys" Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Choose which shortcuts FlowDesk handles, then edit a row to change its keys. Resetting restores the defaults, and pausing keeps your choices."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Filter shortcuts"
                             PlaceholderText="Name or keys"
                             Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter shortcuts by name or keys" />
                    <Button Grid.Column="1" Content="Turn all on"
                            Command="{Binding TurnAllOnCommand}"
                            VerticalAlignment="Bottom" MinHeight="32" />
                    <Button Grid.Column="2" Command="{Binding RefreshCommand}"
                            VerticalAlignment="Bottom" MinHeight="32" Width="32" Padding="0"
                            AutomationProperties.Name="Refresh shortcut status"
                            ToolTipService.ToolTip="Refresh shortcut status">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Summary}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="1" Content="Reset all shortcuts"
                                     Click="ResetAll_Click"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Reset all shortcuts to their defaults"
                                     ToolTipService.ToolTip="Restore every shortcut to its default keys" />
                </Grid>
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                             AutomationProperties.Name="Refreshing shortcut status" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20" Spacing="0">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderThickness="0,0,0,1"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid ColumnSpacing="12" MinHeight="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{Binding Label}" />
                                                <ItemsControl Grid.Row="0" Grid.Column="1"
                                                              ItemsSource="{Binding Keys}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                        Padding="6,2" Margin="0,0,4,0">
                                                                    <TextBlock Text="{Binding Key}"
                                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Join}"
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,4,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Grid.Row="0" Grid.Column="2"
                                                            ToolTipService.ToolTip="{Binding EditHint}"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Custom"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsCustom, Converter={StaticResource BoolVisibility}}" />
                                                    <Button Content="Edit"
                                                            Click="Edit_Click"
                                                            IsEnabled="{Binding CanEdit}"
                                                            AutomationProperties.Name="{Binding EditAutomationName}"
                                                            AutomationProperties.HelpText="{Binding EditHint}"
                                                            ToolTipService.ToolTip="{Binding EditHint}"
                                                            MinWidth="0" MinHeight="32" Padding="12,4"
                                                            VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                                              IsOn="{Binding IsOn, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              OnContent="" OffContent=""
                                                              Width="40" MinWidth="0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding AutomationName}" />
                                                <Grid Grid.Row="1" Grid.Column="0"
                                                            ColumnSpacing="4"
                                                            Margin="0,2,0,0"
                                                            Visibility="{Binding ShowStatus, Converter={StaticResource BoolVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding IsConflict, Converter={StaticResource BoolVisibility}}"
                                                              AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsNeutralStatus, Converter={StaticResource BoolVisibility}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsConflict, Converter={StaticResource BoolVisibility}}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No shortcuts match this filter. Try a different name or key."
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolVisibility}}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="8">
                <TextBlock Text="Other FlowDesk input"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Quick Look and mouse-wheel gestures use hooks. Conflicts with other apps cannot be checked."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Border Padding="0,8" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Quick Look"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding QuickLookSummary}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="Settings"
                                         Command="{Binding OpenSettingsCommand}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Open Quick Look settings" />
                    </Grid>
                </Border>
                <Border Padding="0,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Hot corners"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding HotCornersSummary}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="Settings"
                                         Command="{Binding OpenSettingsCommand}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Open hot corners settings" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
