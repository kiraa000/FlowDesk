<Page
    x:Class="FlowDesk.App.Views.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Text="Hotkeys" Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Choose which shortcuts FlowDesk handles. Active means registered; pausing keeps your choices. Keys cannot be reassigned yet."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Filter shortcuts"
                             PlaceholderText="Name or keys"
                             Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter shortcuts by name or keys" />
                    <Button Grid.Column="1" Content="Turn all on"
                            Command="{Binding TurnAllOnCommand}"
                            VerticalAlignment="Bottom" MinHeight="32" />
                    <Button Grid.Column="2" Command="{Binding RefreshCommand}"
                            VerticalAlignment="Bottom" MinHeight="32" Width="32" Padding="0"
                            AutomationProperties.Name="Refresh shortcut status"
                            ToolTipService.ToolTip="Refresh shortcut status">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding Summary}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                             AutomationProperties.Name="Refreshing shortcut status" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20" Spacing="0">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,12" BorderThickness="0,0,0,1"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding Keys}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                            Padding="6,2" Margin="0,0,4,0">
                                                                        <TextBlock Text="{Binding Key}"
                                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Join}"
                                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,4,0" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Label}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1"
                                                              IsOn="{Binding IsOn, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              OnContent="" OffContent=""
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding AutomationName}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No shortcuts match this filter. Try a different name or key."
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolVisibility}}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="8">
                <TextBlock Text="Other FlowDesk input"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border Padding="0,8" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Quick Look"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding QuickLookSummary}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="Settings"
                                         Command="{Binding OpenSettingsCommand}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Open Quick Look settings" />
                    </Grid>
                </Border>
                <Border Padding="0,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Hot corners"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding HotCornersSummary}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="Settings"
                                         Command="{Binding OpenSettingsCommand}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Open hot corners settings" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
