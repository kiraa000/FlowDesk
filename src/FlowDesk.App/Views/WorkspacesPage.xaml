<Page
    x:Class="FlowDesk.App.Views.WorkspacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FlowDesk.App.ViewModels">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="24">
            <TextBlock Text="Workspaces" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <SplitButton x:Name="NewWorkspace" Content="New workspace"
                         Click="NewWorkspace_Click" AccessKey="N"
                         Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolVisibility}}"
                         Background="{ThemeResource AccentFillColorDefaultBrush}"
                         Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Empty workspace"
                                        Command="{Binding NewEmptyCommand}" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"
                        Spacing="12" Margin="0,24,0,0">
                <FontIcon Glyph="&#xE734;" FontSize="32"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                <TextBlock Text="No workspaces yet" Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Save your open apps and return to them with one click."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <Button Content="Save open windows" Command="{Binding NewFromWindowsCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Workspaces}"
                          Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceViewModel">
                        <Border Padding="16" Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding Color, Converter={StaticResource TagColor}}" />
                                    <FontIcon Glyph="{Binding Glyph}" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OpeningText}"
                                               Visibility="{Binding IsOpening, Converter={StaticResource BoolVisibility}}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ProgressRing Grid.Column="2" IsActive="{Binding IsOpening}"
                                              Visibility="{Binding IsOpening, Converter={StaticResource BoolVisibility}}"
                                              Width="24" Height="24" />
                                <Button Grid.Column="3" Content="Open" Command="{Binding OpenCommand}"
                                        MinWidth="64" />
                                <Button Grid.Column="4" MinWidth="32" ToolTipService.ToolTip="More workspace actions"
                                        AutomationProperties.Name="Workspace actions">
                                    <Button.Content><FontIcon Glyph="&#xE712;" FontSize="16" /></Button.Content>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Edit" Command="{Binding EditCommand}" />
                                            <MenuFlyoutItem Text="Save current positions"
                                                Command="{Binding SavePositionsCommand}" />
                                            <MenuFlyoutItem Text="Reset to saved layout"
                                                Command="{Binding ResetCommand}" />
                                            <MenuFlyoutItem Text="Duplicate" Command="{Binding DuplicateCommand}" />
                                            <MenuFlyoutItem Text="Delete" Command="{Binding DeleteCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
