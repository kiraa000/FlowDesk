<Page
    x:Class="FlowDesk.App.Views.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FlowDesk.App.Services"
    xmlns:vm="using:FlowDesk.App.ViewModels">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="24">
            <TextBlock Text="Focus" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <Border Padding="24"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Session running" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource DisplayTextBlockStyle}"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                 AutomationProperties.Name="Session progress" />
                    <TextBlock Text="{Binding SessionDescription}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"
                                MinWidth="88"
                                Visibility="{Binding CanPause, Converter={StaticResource BoolVisibility}}" />
                        <Button Content="End session" Command="{Binding EndCommand}" AccessKey="E" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="24"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolVisibility}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Session" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <RadioButtons Header="Length" MaxColumns="3"
                                  ItemsSource="{Binding Durations}"
                                  SelectedItem="{Binding Duration, Mode=TwoWay}">
                        <RadioButtons.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="min" Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </RadioButtons.ItemTemplate>
                    </RadioButtons>
                    <RadioButtons Header="Strictness"
                                  SelectedIndex="{Binding StrictnessIndex, Mode=TwoWay}">
                        <RadioButton AutomationProperties.Name="Gentle">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Gentle reminder"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Warn once when a blocked app opens, then leave it open."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Normal">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Normal"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Close the blocked app. It can be allowed again for 5 minutes."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Strict">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Strict"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Close the blocked app every time. No pause and no 5-minute allowance."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                    <ToggleSwitch Header="Block every app that isn't allowed"
                                  OnContent="Only allowed apps stay open"
                                  OffContent="Only the blocked list is enforced"
                                  IsOn="{Binding BlockAll, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Blocked apps"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <DropDownButton Grid.Column="1" Content="Add"
                                        AutomationProperties.Name="Add blocked app">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Running app"
                                                    Command="{Binding AddRunningCommand}"
                                                    CommandParameter="Blocked" />
                                    <MenuFlyoutItem Text="Browse for .exe"
                                                    Command="{Binding BrowseCommand}"
                                                    CommandParameter="Blocked" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <TextBlock Text="No blocked apps yet. Add the apps you want to keep out of a session."
                               Visibility="{Binding BlockedEmpty, Converter={StaticResource BoolVisibility}}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Blocked}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FocusRuleRow">
                                <Border Padding="12" Margin="0,0,0,8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="32" Height="32">
                                            <FontIcon Glyph="&#xE71D;" FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image services:IconSource.Path="{Binding ExePath}"
                                                   Width="24" Height="24" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Remove"
                                                Click="RemoveBlocked_Click"
                                                AutomationProperties.Name="Remove blocked app" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Allowed apps"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <DropDownButton Grid.Column="1" Content="Add"
                                        AutomationProperties.Name="Add allowed app">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Running app"
                                                    Command="{Binding AddRunningCommand}"
                                                    CommandParameter="Allowed" />
                                    <MenuFlyoutItem Text="Browse for .exe"
                                                    Command="{Binding BrowseCommand}"
                                                    CommandParameter="Allowed" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <TextBlock Text="These apps always stay open, even when every other app is blocked."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="No allowed apps yet."
                               Visibility="{Binding AllowedEmpty, Converter={StaticResource BoolVisibility}}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Allowed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FocusRuleRow">
                                <Border Padding="12" Margin="0,0,0,8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="32" Height="32">
                                            <FontIcon Glyph="&#xE71D;" FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image services:IconSource.Path="{Binding ExePath}"
                                                   Width="24" Height="24" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Remove"
                                                Click="RemoveAllowed_Click"
                                                AutomationProperties.Name="Remove allowed app" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Start focus" Command="{Binding StartCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            AccessKey="S" MinWidth="120" />
                    <TextBlock Text="Blocked apps are closed or warned according to the strictness above."
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
