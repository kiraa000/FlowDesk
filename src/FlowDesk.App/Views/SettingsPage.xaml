<Page
    x:Class="FlowDesk.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:FlowDesk.App.Views">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <settings:SettingsCard Header="Theme" Description="Choose how FlowDesk appears." Margin="0,20,0,0">
                <ComboBox ItemsSource="{Binding Themes}"
                          AutomationProperties.Name="Theme"
                          SelectedItem="{Binding Theme, Mode=TwoWay}" MinWidth="160" />
            </settings:SettingsCard>
            <settings:SettingsCard x:Name="AdvancedModeCard" Header="Advanced mode" IsTabStop="False"
                Description="Find trusted third-party tools for changes to Windows itself. Review the precautions before turning this on.">
                <ToggleSwitch x:Name="AdvancedModeSwitch" AutomationProperties.Name="Advanced mode"
                              Toggled="AdvancedMode_Toggled" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="When switching workspaces"
                Description="Minimize the previous workspace's windows.">
                <ToggleSwitch IsOn="{Binding MinimizePrevious, Mode=TwoWay}"
                              AutomationProperties.Name="Minimize previous workspace windows" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Launch timeout"
                Description="Seconds to wait for each app to show its window when opening a workspace.">
                <NumberBox Value="{Binding LaunchTimeout, Mode=TwoWay}" Minimum="10" Maximum="60"
                           SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                           Width="140" AutomationProperties.Name="Launch timeout in seconds" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Window shortcuts">
                <settings:SettingsCard.Description>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Snap, focus, switch desktops and resize windows with Alt shortcuts."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WindowShortcutsStatus}"
                                   Visibility="{Binding WindowShortcuts, Converter={StaticResource BoolVisibility}}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ShortcutConflicts}"
                                   Visibility="{Binding HasShortcutConflicts, Converter={StaticResource BoolVisibility}}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </settings:SettingsCard.Description>
                <ToggleSwitch IsOn="{Binding WindowShortcuts, Mode=TwoWay}"
                              IsEnabled="{Binding WindowShortcutsCanToggle}"
                              AutomationProperties.Name="Window shortcuts" />
            </settings:SettingsCard>
            <StackPanel Spacing="8" Margin="0,4,0,8"
                        Visibility="{Binding WindowShortcuts, Converter={StaticResource BoolVisibility}}">
                <Button Content="Choose file…" Command="{Binding ChooseShortcutsDllCommand}" MinHeight="32"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Choose VirtualDesktopAccessor.dll"
                        Visibility="{Binding WindowShortcutsDesktopUnavailable, Converter={StaticResource BoolVisibility}}" />
                <InfoBar Severity="Warning" IsOpen="{Binding AutoHotkeyRunning, Mode=OneWay}" IsClosable="False"
                         Title="AutoHotkey is running"
                         Message="If it uses the same shortcuts, it handles them before FlowDesk." />
                <settings:SettingsCard Header="Terminal program"
                    Description="Program that Alt+Enter starts in your profile folder. Leave blank to use Windows Terminal if available, otherwise Command Prompt; FlowDesk adds no arguments.">
                    <StackPanel Spacing="8" Width="220">
                        <TextBox Text="{Binding TerminalProgram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32"
                                 PlaceholderText="Windows Terminal or Command Prompt"
                                 AutomationProperties.Name="Terminal program" />
                        <Button Content="Use default" Command="{Binding UseDefaultTerminalCommand}" MinHeight="32"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Use the default terminal program" />
                    </StackPanel>
                </settings:SettingsCard>
                <StackPanel Spacing="4">
                    <TextBlock Text="Choose which shortcuts FlowDesk handles."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <HyperlinkButton Content="Manage shortcuts in the Hotkeys tab"
                                     Command="{Binding ManageShortcutsCommand}"
                                     AutomationProperties.Name="Manage shortcuts in the Hotkeys tab" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="4">
                <settings:SettingsCard Header="Command palette">
                    <settings:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding PaletteDescription}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PaletteStatus}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </settings:SettingsCard.Description>
                    <ToggleSwitch IsOn="{Binding CommandPalette, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Open with the Windows key">
                    <settings:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Pressing and releasing the Windows key on its own opens the palette instead of Start. Ctrl+Esc still opens Start."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PaletteWindowsKeyStatus}"
                                       Visibility="{Binding PaletteWindowsKeyStatusVisibility}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </settings:SettingsCard.Description>
                    <ToggleSwitch IsOn="{Binding PaletteWindowsKey, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteWindowsKeyCanToggle}"
                                  AutomationProperties.Name="Open with the Windows key" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Open windows"
                    Description="Switch to another open window from the palette.">
                    <ToggleSwitch IsOn="{Binding PaletteWindowsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Open windows in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="File search">
                    <settings:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Search indexed files and folders with f or in mixed results."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PaletteFileBackendStatus}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </settings:SettingsCard.Description>
                    <ToggleSwitch IsOn="{Binding PaletteFilesEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="File search in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Edge bookmarks"
                    Description="Search bookmarks from all Edge profiles with b or in mixed results.">
                    <ToggleSwitch IsOn="{Binding PaletteEdgeBookmarks, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Edge bookmarks in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Chrome bookmarks"
                    Description="Search bookmarks from all Chrome profiles with b or in mixed results.">
                    <ToggleSwitch IsOn="{Binding PaletteChromeBookmarks, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Chrome bookmarks in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Firefox bookmarks"
                    Description="Search bookmarks from all Firefox profiles with b or in mixed results.">
                    <ToggleSwitch IsOn="{Binding PaletteFirefoxBookmarks, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Firefox bookmarks in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsExpander Header="Custom commands"
                    Description="Run your own links, files, programs and PowerShell scripts from the palette.">
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{Binding CustomCommands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Keywords}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Edit" Tag="{Binding}"
                                                            Click="EditCustomCommand_Click" MinHeight="32"
                                                            AutomationProperties.Name="Edit custom command"
                                                            ToolTipService.ToolTip="{Binding Name}" />
                                                    <Button Content="Test" Tag="{Binding}"
                                                            Click="TestCustomCommand_Click" MinHeight="32"
                                                            AutomationProperties.Name="Test custom command"
                                                            ToolTipService.ToolTip="{Binding Name}" />
                                                    <Button Content="Delete" Tag="{Binding}"
                                                            Click="DeleteCustomCommand_Click" MinHeight="32"
                                                            AutomationProperties.Name="Delete custom command"
                                                            ToolTipService.ToolTip="{Binding Name}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Add command" Click="AddCustomCommand_Click" MinHeight="32"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Add custom command" />
                                <TextBlock Text="{Binding CustomCommandsError}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <settings:SettingsCard Header="Run history" Description="Keep the last 20 command lines used with the &gt; prefix.">
                    <Button Content="Clear history" Command="{Binding ClearPaletteRunHistoryCommand}"
                            AutomationProperties.Name="Clear palette run history" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Calculator"
                    Description="Math, unit conversion and time zones in the search box.">
                    <ToggleSwitch IsOn="{Binding PaletteCalculatorEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Calculator in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="System commands"
                    Description="Lock, sleep and other Windows commands.">
                    <ToggleSwitch IsOn="{Binding PaletteSystemEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="System commands in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Web search"
                    Description="Search the web from the palette.">
                    <ToggleSwitch IsOn="{Binding PaletteWebEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Web search in the command palette" />
                </settings:SettingsCard>
                <settings:SettingsCard Header="Search engine">
                    <settings:SettingsCard.Description>
                        <TextBlock Text="Used by the web search row and the ? prefix."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </settings:SettingsCard.Description>
                    <StackPanel Spacing="8" Width="260">
                        <ComboBox SelectedIndex="{Binding PaletteWebEngineIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Web search engine">
                            <ComboBoxItem Content="Google" />
                            <ComboBoxItem Content="Bing" />
                            <ComboBoxItem Content="DuckDuckGo" />
                            <ComboBoxItem Content="Brave" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <TextBox Text="{Binding PaletteWebTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding PaletteCustomVisibility}"
                                 MinHeight="32"
                                 MaxLength="2048" PlaceholderText="https://example.com/search?q=%s"
                                 AutomationProperties.Name="Custom search URL template" />
                        <TextBlock Text="{Binding PaletteWebTemplateError}"
                                   Visibility="{Binding PaletteWebTemplateErrorVisibility}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard Header="Show a web search row"
                    Description="Adds &#x201C;Search the web for &#x2026;&#x201D; at the bottom of results. Nothing is sent until you press Enter.">
                    <ToggleSwitch IsOn="{Binding PaletteWebFallback, Mode=TwoWay}"
                                  IsEnabled="{Binding PaletteCanToggle}"
                                  AutomationProperties.Name="Show a web search row" />
                </settings:SettingsCard>
                <settings:SettingsExpander Header="AI answers"
                    Description="Answers from a provider you choose. Off until configured.">
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <local:AiSettingsPanel />
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <settings:SettingsCard Header="Clipboard history">
                    <settings:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Keep up to 50 text items in memory. Cleared when turned off or FlowDesk exits."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ClipboardStatus}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </settings:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear" Command="{Binding ClearClipboardCommand}" MinHeight="32"
                                AutomationProperties.Name="Clear clipboard history" />
                        <ToggleSwitch IsOn="{Binding ClipboardHistory, Mode=TwoWay}"
                                      IsEnabled="{Binding PaletteCanToggle}"
                                      AutomationProperties.Name="Clipboard history" />
                    </StackPanel>
                </settings:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="4">
                <settings:SettingsCard Header="Quick Look"
                    Description="Preview the file selected in File Explorer or on the desktop with Space.">
                    <ToggleSwitch IsOn="{Binding QuickLook, Mode=TwoWay}"
                                  AutomationProperties.Name="Quick Look file preview" />
                </settings:SettingsCard>
                <InfoBar Severity="Warning" IsOpen="{Binding HasQuickLookConflict, Mode=OneWay}" IsClosable="False"
                         Title="Another preview tool is running"
                         Message="{Binding QuickLookConflict}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <settings:SettingsCard Header="Hot corners"
                    Description="Rest in an outer screen corner briefly to run an action.">
                    <ToggleSwitch IsOn="{Binding HotCorners, Mode=TwoWay}"
                                  IsEnabled="{Binding HotCornersCanToggle}"
                                  AutomationProperties.Name="Hot corners" />
                </settings:SettingsCard>
                <StackPanel Spacing="8" Margin="0,4,0,8"
                            Visibility="{Binding HotCorners, Converter={StaticResource BoolVisibility}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Top-left" VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <ComboBox Grid.Column="1" MinWidth="180" IsEnabled="{Binding HotCornersCanToggle}"
                                  ItemsSource="{Binding HotCornerActions}"
                                  DisplayMemberPath="Label"
                                  SelectedIndex="{Binding HotCornerTopLeftIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Top-left hot corner action" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Top-right" VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <ComboBox Grid.Column="1" MinWidth="180" IsEnabled="{Binding HotCornersCanToggle}"
                                  ItemsSource="{Binding HotCornerActions}"
                                  DisplayMemberPath="Label"
                                  SelectedIndex="{Binding HotCornerTopRightIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Top-right hot corner action" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bottom-left" VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <ComboBox Grid.Column="1" MinWidth="180" IsEnabled="{Binding HotCornersCanToggle}"
                                  ItemsSource="{Binding HotCornerActions}"
                                  DisplayMemberPath="Label"
                                  SelectedIndex="{Binding HotCornerBottomLeftIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Bottom-left hot corner action" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bottom-right" VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <ComboBox Grid.Column="1" MinWidth="180" IsEnabled="{Binding HotCornersCanToggle}"
                                  ItemsSource="{Binding HotCornerActions}"
                                  DisplayMemberPath="Label"
                                  SelectedIndex="{Binding HotCornerBottomRightIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Bottom-right hot corner action" />
                    </Grid>
                    <TextBlock Text="Outer corners only. Dragging and full-screen apps suspend hot corners."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <settings:SettingsCard Header="Start with Windows"
                Description="Open FlowDesk when you sign in.">
                <ToggleSwitch IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                              AutomationProperties.Name="Start FlowDesk when I sign in" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Onboarding tour"
                Description="Walk through the main screens again.">
                <Button Content="Show the tour again" Command="{Binding ReplayTourCommand}" MinHeight="32" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Back up or move FlowDesk"
                Description="Export a backup or import settings from another PC.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ExportTransferButton" Content="Export…" Click="ExportTransfer_Click" MinHeight="32"
                            AutomationProperties.Name="Export FlowDesk settings" />
                    <Button x:Name="ImportTransferButton" Content="Import…" Click="ImportTransfer_Click" MinHeight="32"
                            AutomationProperties.Name="Import FlowDesk settings" />
                </StackPanel>
            </settings:SettingsCard>
            <settings:SettingsCard Header="Data folder"
                Description="Workspaces, focus sessions and app settings.">
                <Button Content="Open folder" Command="{Binding OpenDataFolderCommand}" MinHeight="32" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="About" Description="{Binding VersionText}">
                <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" MinHeight="32" />
            </settings:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
