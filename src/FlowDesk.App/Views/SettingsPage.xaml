<Page
    x:Class="FlowDesk.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <settings:SettingsCard Header="Theme" Description="Choose how FlowDesk appears." Margin="0,20,0,0">
                <ComboBox ItemsSource="{Binding Themes}"
                          AutomationProperties.Name="Theme"
                          SelectedItem="{Binding Theme, Mode=TwoWay}" MinWidth="160" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="When switching workspaces"
                Description="Minimize the previous workspace's windows.">
                <ToggleSwitch IsOn="{Binding MinimizePrevious, Mode=TwoWay}"
                              AutomationProperties.Name="Minimize previous workspace windows" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Launch timeout"
                Description="Seconds to wait for each app to show its window when opening a workspace.">
                <NumberBox Value="{Binding LaunchTimeout, Mode=TwoWay}" Minimum="10" Maximum="60"
                           SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                           Width="140" AutomationProperties.Name="Launch timeout in seconds" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Window shortcuts"
                Description="Snap, focus, switch desktops and resize windows with Alt shortcuts.">
                <ToggleSwitch IsOn="{Binding WindowShortcuts, Mode=TwoWay}"
                              IsEnabled="{Binding WindowShortcutsCanToggle}"
                              AutomationProperties.Name="Window shortcuts" />
            </settings:SettingsCard>
            <StackPanel Spacing="8" Margin="0,4,0,8"
                        Visibility="{Binding WindowShortcuts, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding WindowShortcutsStatus}" Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Button Content="Choose file…" Command="{Binding ChooseShortcutsDllCommand}" MinHeight="32"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Choose VirtualDesktopAccessor.dll"
                        Visibility="{Binding WindowShortcutsDesktopUnavailable, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding ShortcutConflicts}" Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                           Visibility="{Binding HasShortcutConflicts, Converter={StaticResource BoolVisibility}}" />
                <InfoBar Severity="Warning" IsOpen="{Binding AutoHotkeyRunning, Mode=OneWay}" IsClosable="False"
                         Title="AutoHotkey is running"
                         Message="If it uses the same shortcuts, it handles them before FlowDesk." />
                <Expander Header="Shortcut list" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding ShortcutLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
            <settings:SettingsCard Header="Start with Windows"
                Description="Open FlowDesk when you sign in.">
                <ToggleSwitch IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                              AutomationProperties.Name="Start FlowDesk when I sign in" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Onboarding tour"
                Description="Walk through the main screens again.">
                <Button Content="Show the tour again" Command="{Binding ReplayTourCommand}" MinHeight="32" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="Data folder"
                Description="Workspaces, focus sessions and app settings.">
                <Button Content="Open folder" Command="{Binding OpenDataFolderCommand}" MinHeight="32" />
            </settings:SettingsCard>
            <settings:SettingsCard Header="About" Description="{Binding VersionText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
