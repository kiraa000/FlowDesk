<Window x:Class="FlowDesk.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Size, placement, theme and behaviour live in CommandPaletteWindow.xaml.cs.
         At 640 x 540 this is 44 search + up to 416 results + footer, on the 4 px grid. -->
    <Grid x:Name="Root" Padding="12" RowSpacing="8"
          Background="{ThemeResource PaletteSurfaceBackgroundBrush}"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource OverlayCornerRadius}"
          KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <!-- Do not stack tinted XAML fills over the system Acrylic. The backdrop
                             supplies its own solid fallback when transparency is unavailable. -->
                        <SolidColorBrush x:Key="PaletteSurfaceBackgroundBrush" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="PaletteSurfaceBackgroundBrush" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="PaletteSurfaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            <!-- Subtitle ramp size (20/28) for the query: the search term is the point of the window. -->
            <Style x:Key="PaletteSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="12,6,12,6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="IsTextPredictionEnabled" Value="False" />
            </Style>
            <Style x:Key="PaletteResultItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Height" Value="52" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="12,4,12,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <TextBox x:Name="SearchBox"
                 MaxLength="256"
                 Grid.Row="0"
                 Style="{StaticResource PaletteSearchBoxStyle}"
                 PlaceholderText="Search workspaces, apps, actions…"
                 AutomationProperties.Name="Command palette search"
                 TextChanged="SearchBox_TextChanged"
                 KeyDown="SearchBox_KeyDown" />

        <Border Grid.Row="1" VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <ListView x:Name="Results"
                      MaxHeight="416"
                      Padding="4"
                      Background="Transparent"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemContainerStyle="{StaticResource PaletteResultItemStyle}"
                       ItemClick="Results_ItemClick"
                       AutomationProperties.Name="Command palette results"
                      SelectionChanged="Results_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="44" ColumnSpacing="12"
                              AutomationProperties.Name="{Binding AutomationName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Glyph first so the real app icon, once loaded, covers it. -->
                            <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding Glyph}"
                                          Visibility="{Binding IconFallbackVisibility}"
                                          FontSize="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image Source="{Binding IconSource}"
                                       Width="24" Height="24"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Regular weight: the Loaded handler bolds the matched characters. -->
                                 <TextBlock x:Name="ResultTitle"
                                             Loaded="ResultTitle_Loaded"
                                             DataContextChanged="ResultTitle_DataContextChanged"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            TextWrapping="NoWrap"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Title}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Subtitle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Hint}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Text="Recent"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Command palette results"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="↑ ↓ to select · Enter to open · Ctrl+Enter for more"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
