<Window x:Class="FlowDesk.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Size, placement, theme and behaviour live in CommandPaletteWindow.xaml.cs.
         At 640 x 540 this is 44 search + up to 416 results + a 32 px footer, on the 4 px grid. -->
    <Grid x:Name="Root"
          Background="{ThemeResource PaletteSurfaceBackgroundBrush}"
          BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- PaletteSurfaceBackgroundBrush lives in App.xaml: this Grid's own Background attribute is
                     resolved before Grid.Resources is set, so a key defined here is not found at start-up. -->
            <!-- Subtitle ramp size (20/28) for the query: the search term is the point of the window. -->
            <Style x:Key="PaletteSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="12,6,12,6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="IsTextPredictionEnabled" Value="False" />
            </Style>
            <Style x:Key="PaletteResultItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Height" Value="52" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="12,4,12,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Fills the surface when Acrylic is unavailable, transparency is off or High Contrast is on.
             It sits inside the 1 px root stroke; code toggles Visibility. -->
        <Border x:Name="SolidFallback"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

        <Grid x:Name="SurfaceContent" Padding="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Mode chip for Clipboard, Windows, Calculator, Web and Help modes. The chip border follows
                     the label's Visibility so code keeps setting Text/Visibility on ClipboardModeLabel. -->
                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="8,2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding Visibility, ElementName=ClipboardModeLabel}">
                    <TextBlock x:Name="ClipboardModeLabel"
                               Text="Clipboard"
                               Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBox x:Name="SearchBox"
                         MaxLength="256"
                         Grid.Column="1"
                         Style="{StaticResource PaletteSearchBoxStyle}"
                         PlaceholderText="Search workspaces, apps, actions…"
                         AutomationProperties.Name="Command palette search"
                         TextChanged="SearchBox_TextChanged" />
                <Button x:Name="ClearClipboardButton"
                        Grid.Column="2"
                        Content="Clear"
                        MinHeight="32"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="ClearClipboard_Click" />
            </Grid>

            <Border Grid.Row="1" VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <ListView x:Name="Results"
                          MaxHeight="416"
                          Padding="4"
                          Background="Transparent"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemContainerStyle="{StaticResource PaletteResultItemStyle}"
                           ItemClick="Results_ItemClick"
                           AutomationProperties.Name="Command palette results"
                          SelectionChanged="Results_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="44" ColumnSpacing="12"
                                  AutomationProperties.Name="{Binding AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Glyph first so the real app icon, once loaded, covers it. -->
                                <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                    <FontIcon Glyph="{Binding Glyph}"
                                              Visibility="{Binding IconFallbackVisibility}"
                                              FontSize="20"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Image Source="{Binding IconSource}"
                                           Width="24" Height="24"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Regular weight: the Loaded handler bolds the matched characters. -->
                                     <TextBlock x:Name="ResultTitle"
                                                 Loaded="ResultTitle_Loaded"
                                                 DataContextChanged="ResultTitle_DataContextChanged"
                                                 Visibility="{Binding NormalTitleVisibility}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                TextWrapping="NoWrap"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                 ToolTipService.ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding ConfirmationPrompt}"
                                               Visibility="{Binding ConfirmationTitleVisibility}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="NoWrap"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Subtitle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Hint}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Answer pane: shares row 1 with the results list; code shows one at a time by
                 toggling this Grid and Results.Visibility. -->
            <Grid x:Name="AnswerPane" Grid.Row="1" Visibility="Collapsed" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="AnswerQuestion"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
                <ScrollViewer x:Name="AnswerScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="416">
                    <RichTextBlock x:Name="AnswerBody"
                                    IsTextSelectionEnabled="True"
                                    IsTabStop="True"
                                    AutomationProperties.Name="AI answer"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </ScrollViewer>
                <TextBlock x:Name="AnswerStatus"
                           Grid.Row="2"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="AI answer status" />
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Recent"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Command palette results"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- Inline caution for confirm rows; code shows it and raises LiveRegionChanged. -->
                <TextBlock x:Name="ConfirmationText"
                           Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            AutomationProperties.LiveSetting="Assertive"
                            AutomationProperties.AccessibilityView="Raw"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <TextBlock x:Name="KeyboardHint"
                           Grid.Column="1"
                           Text="↑ ↓ to select · Enter to open · Ctrl+Enter for more"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           MaxLines="1"
                           MaxWidth="320"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="ActionsButton"
                        Grid.Column="2"
                        Content="Actions · Ctrl+K"
                        MinHeight="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Click="Actions_Click" />
                <Button x:Name="HelpButton"
                        Grid.Column="3"
                        Content="Help"
                        MinHeight="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Click="Help_Click"
                        AutomationProperties.Name="Palette keyboard help" />
            </Grid>
        </Grid>
    </Grid>
</Window>
