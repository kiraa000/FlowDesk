<Page
    x:Class="FlowDesk.App.Views.CalmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
        <StackPanel Margin="32,24" MaxWidth="1000" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Text="Calm" Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Choose what Windows shows. Every FlowDesk change can be undone."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Summary}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button Content="Run check-up" Command="{Binding RunCheckCommand}"
                                Style="{StaticResource AccentButtonStyle}" AccessKey="R"
                                AutomationProperties.Name="Run Windows check-up" />
                        <Button x:Name="CalmAllButton" Content="Calm all" Command="{Binding CalmAllCommand}"
                                AutomationProperties.Name="Calm all suggested Windows settings" />
                    </StackPanel>
                    <ContentControl IsTabStop="False"
                                    HorizontalContentAlignment="Left">
                        <HyperlinkButton Content="Undo all FlowDesk changes"
                                         Command="{Binding UndoAllCommand}"
                                         Click="UndoAll_Click"
                                         IsEnabled="{Binding HasUndo}"
                                         AutomationProperties.Name="Undo all FlowDesk changes"
                                         ToolTipService.ToolTip="Restore the values saved before FlowDesk changed Windows" />
                    </ContentControl>
                </StackPanel>
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"
                             AutomationProperties.Name="Running Windows check-up" />
                <TextBlock Text="{Binding LastChecked}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <InfoBar Severity="Error" IsOpen="{Binding ErrorOpen, Mode=TwoWay}"
                         Message="{Binding Error}" />
                <InfoBar Severity="Informational" IsOpen="{Binding RestartSuggested, Mode=TwoWay}"
                         Title="Some changes need a File Explorer restart"
                         Message="Some changes apply after you restart File Explorer or sign out.">
                    <InfoBar.ActionButton>
                        <Button Content="Restart File Explorer"
                                Command="{Binding RestartExplorerCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <ContentControl IsTabStop="False"
                            HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="24">
                <ItemsControl IsTabStop="False" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="24" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <ItemsControl IsTabStop="False" ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:SettingsCard IsTabStop="False" Header="{Binding Title}">
                                                <controls:SettingsCard.Description>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Caption}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </controls:SettingsCard.Description>
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <ToggleSwitch IsOn="{Binding IsOn, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  Visibility="{Binding IsToggle, Converter={StaticResource BoolVisibility}}"
                                                                  OnContent="On" OffContent="Off"
                                                                  AutomationProperties.Name="{Binding Title}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsSearch, Converter={StaticResource BoolVisibility}}">
                                                        <ComboBox SelectedIndex="{Binding SelectedSearch, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanChange}"
                                                                  AutomationProperties.Name="Search on the taskbar">
                                                            <ComboBoxItem Content="Hidden" />
                                                            <ComboBoxItem Content="Icon" />
                                                            <ComboBoxItem Content="Box" />
                                                        </ComboBox>
                                                        <Button Content="Apply"
                                                                Command="{Binding ChangeCommand}"
                                                                IsEnabled="{Binding CanApplySearch}"
                                                                AutomationProperties.Name="Apply search choice"
                                                                ToolTipService.ToolTip="Apply the selected search setting" />
                                                    </StackPanel>
                                                    <HyperlinkButton Content="Undo"
                                                                     Command="{Binding UndoCommand}"
                                                                     Click="UndoRow_Click"
                                                                     Visibility="{Binding HasUndo, Converter={StaticResource BoolVisibility}}"
                                                                     AutomationProperties.Name="{Binding UndoName}"
                                                                     ToolTipService.ToolTip="Restore the value from before FlowDesk changed it" />
                                                </StackPanel>
                                            </controls:SettingsCard>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="4">
                    <TextBlock Text="Startup apps"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Startup apps are your choice and are never included in Calm all."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl IsTabStop="False" ItemsSource="{Binding StartupApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SettingsCard IsTabStop="False" Header="{Binding Name}">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="{Binding Caption}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   ToolTipService.ToolTip="{Binding Command}" />
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <ToggleSwitch IsOn="{Binding IsOn, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanChange}"
                                                      AutomationProperties.Name="{Binding Name}" />
                                        <HyperlinkButton Content="Undo"
                                                         Command="{Binding UndoCommand}"
                                                         Click="UndoRow_Click"
                                                         Visibility="{Binding HasUndo, Converter={StaticResource BoolVisibility}}"
                                                         AutomationProperties.Name="{Binding UndoName}"
                                                         ToolTipService.ToolTip="Restore this startup app to its previous state" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:SettingsCard IsTabStop="False" Header="Other startup apps"
                                           Description="Machine-wide and packaged apps are managed by Windows.">
                        <Button Content="Open in Settings"
                                Command="{Binding OpenStartupSettingsCommand}"
                                AutomationProperties.Name="Open startup apps in Windows Settings" />
                    </controls:SettingsCard>
                </StackPanel>

                <controls:SettingsCard IsTabStop="False" Header="Windows Update"
                                       Description="{Binding ActiveHours}">
                    <Button Content="Open in Settings"
                            Command="{Binding OpenUpdateSettingsCommand}"
                            AutomationProperties.Name="Open Windows Update settings" />
                </controls:SettingsCard>
            </StackPanel>
            </ContentControl>
            <controls:SettingsCard IsTabStop="False" Header="System-wide changes"
                Description="Changes that need administrator rights are outside FlowDesk. Use trusted tools in the Advanced tab.">
                <Button Content="{Binding AdvancedLinkText}" Command="{Binding OpenAdvancedCommand}" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
