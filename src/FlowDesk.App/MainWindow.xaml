<Window
    x:Class="FlowDesk.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tray="using:H.NotifyIcon">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <tray:TaskbarIcon x:Name="TrayIcon" ToolTipText="FlowDesk" NoLeftClickDelay="True">
            <tray:TaskbarIcon.IconSource>
                <BitmapImage UriSource="ms-appx:///Assets/FlowDesk.png" />
            </tray:TaskbarIcon.IconSource>
            <tray:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayOpen" Text="Open FlowDesk" />
                    <MenuFlyoutItem x:Name="TrayPause" Text="Pause" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayExit" Text="Exit" />
                </MenuFlyout>
            </tray:TaskbarIcon.ContextFlyout>
        </tray:TaskbarIcon>
        <Grid x:Name="TitleBar" Margin="16,0,140,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/FlowDesk.png" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="FlowDesk" VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto"
            OpenPaneLength="280" ExpandedModeThresholdWidth="800"
            IsSettingsVisible="True" IsBackButtonVisible="Collapsed"
            SelectionChanged="Navigation_SelectionChanged" ItemInvoked="Navigation_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Workspaces" Tag="Workspaces">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Layouts" Tag="Layouts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Focus" Tag="Focus">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE916;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar AutomationProperties.AutomationId="AppStatusBar" Margin="32,12,32,0" IsOpen="{Binding StatusOpen, Mode=TwoWay}"
                    Message="{Binding StatusMessage}" Severity="{Binding StatusKind, Converter={StaticResource StatusKind}}">
                    <InfoBar.ActionButton>
                        <Button Content="Details" Command="{Binding ShowReportCommand}"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolVisibility}}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar AutomationProperties.AutomationId="NewWindowBar" Grid.Row="1" Margin="32,8,32,0"
                    IsOpen="{Binding AutoSave.OfferOpen}" IsClosable="False" Severity="Informational"
                    Title="New window" Message="{Binding AutoSave.OfferText}">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Add" Command="{Binding AutoSave.AcceptOfferCommand}" />
                            <Button Content="Not now" Command="{Binding AutoSave.DeclineOfferCommand}" />
                            <Button Content="Always add new windows"
                                Command="{Binding AutoSave.AlwaysAddOfferCommand}" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <InfoBar AutomationProperties.AutomationId="BrowserRestoreBar" Grid.Row="2" Margin="32,8,32,0"
                    IsOpen="{Binding BrowserNotice.IsOpen}" IsClosable="False" Severity="Informational"
                    Title="Reopen your last browser tabs" Message="{Binding BrowserNotice.NoticeText}">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0">
                            <HyperlinkButton Content="Learn more"
                                AutomationProperties.Name="Learn more about reopening your last browser tabs"
                                Click="BrowserHelp_Click" />
                            <Button Content="Got it" Command="{Binding BrowserNotice.DismissCommand}" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <ProgressBar Grid.Row="3" IsIndeterminate="True" Margin="32,8,32,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                <Frame x:Name="PageFrame" Grid.Row="4" />
            </Grid>
        </NavigationView>
        <TeachingTip x:Name="TourTip" Grid.RowSpan="2" IsOpen="False" IsLightDismissEnabled="False" ShouldConstrainToRootBounds="True"
                     CloseButtonContent="Skip tour" CloseButtonClick="TourTip_CloseButtonClick"
                     Closed="TourTip_Closed">
            <StackPanel Spacing="12" KeyDown="TourContent_KeyDown">
                <TextBlock x:Name="TourStepText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TourBack" Content="Back" MinHeight="32" Click="TourBack_Click" />
                    <Button x:Name="TourNext" Content="Next" MinHeight="32" Click="TourNext_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </TeachingTip>
        <ContentDialog x:Name="BrowserHelpDialog" Grid.RowSpan="2" Title="Reopen your last browser tabs"
                       CloseButtonText="Close" DefaultButton="Close"
                       AutomationProperties.Name="Browser tab restore help">
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding BrowserNotice.HelpText}" Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
